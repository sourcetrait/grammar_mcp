{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity_manifest.schema.json",
  "title": "grammard fixture identity manifest",
  "description": "A fixture run's endpoint descriptor: its endpoints, the expected identities on each, the public trust material by fingerprint, and the credentials by reference. The private copy names credential files; the redacted copy omits them. Neither carries a key's body.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "lab_admin", "candidates", "endpoints", "mtls"],
  "properties": {
    "schema_version": { "const": 1 },
    "run": { "$ref": "#/$defs/identifier" },
    "lab_admin": {
      "description": "The isolated lab's administration capability, explicit and scoped to the fixture.",
      "type": "object",
      "additionalProperties": false,
      "required": ["via", "scope"],
      "properties": {
        "via": { "type": "string" },
        "scope": { "type": "string" }
      }
    },
    "candidates": {
      "description": "Candidate executable locations, null until a candidate set exists.",
      "type": ["null", "object"]
    },
    "endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpoint" } },
    "mtls": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/mtls" }] }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "worker_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "not": { "enum": [".", ".."] } },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fingerprint": { "type": "string", "minLength": 1 },
    "reference": {
      "description": "A path to a file, never its contents.",
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "PRIVATE KEY" }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "arch", "route", "host_key_alias", "host_key", "accounts", "worker", "trust", "credentials", "verified"],
      "properties": {
        "profile": { "type": "string" },
        "arch": { "enum": ["amd64", "riscv64"] },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "bind", "port", "forward_port"],
          "properties": {
            "host": { "type": "string" },
            "bind": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "forward_port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "host_key_alias": { "type": "string" },
        "host_key": { "$ref": "#/$defs/fingerprint" },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user", "uid", "keys"],
            "properties": {
              "user": { "type": "string" },
              "uid": { "type": "integer", "minimum": 1 },
              "keys": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "namespace", "instance_key", "socket"],
          "properties": {
            "id": { "$ref": "#/$defs/worker_name" },
            "namespace": { "$ref": "#/$defs/worker_name" },
            "instance_key": { "$ref": "#/$defs/sha256_hex" },
            "socket": { "type": "string" }
          }
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_ca", "unknown_ca", "krl_sha256", "certs"],
          "properties": {
            "host_ca": { "$ref": "#/$defs/fingerprint" },
            "unknown_ca": { "$ref": "#/$defs/fingerprint" },
            "krl_sha256": { "$ref": "#/$defs/sha256_hex" },
            "certs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["case", "serial", "principal", "ca", "revoked", "sha256"],
                "properties": {
                  "case": { "type": "string" },
                  "serial": { "type": "integer", "minimum": 0 },
                  "principal": { "type": "string" },
                  "ca": { "type": "string" },
                  "revoked": { "type": "boolean" },
                  "sha256": { "$ref": "#/$defs/sha256_hex" }
                }
              }
            }
          }
        },
        "credentials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "fingerprint"],
            "properties": {
              "name": { "type": "string" },
              "file": { "$ref": "#/$defs/reference" },
              "fingerprint": { "$ref": "#/$defs/fingerprint" }
            }
          }
        },
        "verified": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["passed", "failed", "restored", "openssh"],
              "properties": {
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "array", "items": { "type": "string" } },
                "restored": { "type": "boolean" },
                "openssh": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "mtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identities", "outcomes"],
      "properties": {
        "identities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "authority", "peers"],
            "properties": {
              "profile": { "type": "string" },
              "authority": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fingerprint", "cert"],
                "properties": {
                  "fingerprint": { "$ref": "#/$defs/fingerprint" },
                  "cert": { "$ref": "#/$defs/reference" }
                }
              },
              "peers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "fingerprint", "cert"],
                  "properties": {
                    "name": { "type": "string" },
                    "fingerprint": { "$ref": "#/$defs/fingerprint" },
                    "cert": { "$ref": "#/$defs/reference" },
                    "key": { "$ref": "#/$defs/reference" }
                  }
                }
              }
            }
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case", "expect", "observed"],
            "properties": {
              "case": { "type": "string" },
              "expect": { "type": "boolean" },
              "observed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
