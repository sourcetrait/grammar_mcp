# Lock: who holds a namespace, the record its worker writes into the namespace lock.
#
# It sits at <data>/grammar/mcp/<id>/<namespace>/host.lock, the lock the MCP's
# host takes, so a worker and a host never hold one namespace together. The
# record is rewritten in place by each worker that takes the lock, its inode
# kept. Its uid, pid, start, and boot name the worker's process as a scratch
# marker does; its generation is the worker's for this start, lower-case hex.

record<
    holder: string,
    uid: int,
    id: string,
    namespace: string,
    pid: int,
    start: int,
    boot: oneof<string, nothing>,
    generation: string
>
